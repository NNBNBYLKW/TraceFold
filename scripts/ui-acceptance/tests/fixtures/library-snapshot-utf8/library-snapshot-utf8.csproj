<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A test fixture, not a product. The workflow-scenario self-test copies this project into a scratch
    directory and builds it there, so the production snapshot read can be exercised against a real
    child process that writes real UTF-8 bytes. It is deliberately absent from every solution file.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>library-snapshot-utf8</AssemblyName>
    <RootNamespace>TraceFold.Media.UiAcceptance.Fixtures.LibrarySnapshotUtf8</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
