<ContentDialog
    x:Class="TraceFold.Media.Desktop.Dialogs.ConflictComparisonDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TraceFold.Media.Desktop.Controls"
    xmlns:dialogs="using:TraceFold.Media.Desktop.Dialogs"
    MinWidth="0"
    AutomationProperties.AutomationId="ConflictComparisonDialog"
    AutomationProperties.Name="文件冲突比较与选择"
    DefaultButton="None"
    Title="发现相同或重复文件">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1120</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
    </ContentDialog.Resources>

    <Grid x:Name="DialogRoot" RowDefinitions="*,Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactDialogLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="IncomingPane.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ExistingPane.(Grid.Row)" Value="1" />
                        <Setter Target="ExistingPane.(Grid.Column)" Value="0" />
                        <Setter Target="ExistingPane.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideDialogLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="IncomingPane.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ExistingPane.(Grid.Row)" Value="0" />
                        <Setter Target="ExistingPane.(Grid.Column)" Value="1" />
                        <Setter Target="ExistingPane.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer
            x:Name="ConflictScrollRoot"
            AutomationProperties.AutomationId="ConflictScrollRoot"
            AutomationProperties.Name="冲突文件比较滚动区域"
            Grid.Row="0"
            VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="18">
            <ScrollViewer x:Name="IncomingPane" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="待入库文件" />
                        <Border
                            Grid.Column="1"
                            Padding="8,3"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            CornerRadius="10">
                            <TextBlock
                                FontSize="12"
                                Text="新文件" />
                        </Border>
                    </Grid>
                    <controls:MediaPreviewControl
                        MinHeight="260"
                        AutomationProperties.AutomationId="ConflictIncomingPreview"
                        AutomationProperties.Name="待入库文件预览"
                        Descriptor="{x:Bind ViewModel.Incoming.Preview, Mode=OneWay}" />
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Incoming.DisplayName}" />
                    <Grid ColumnDefinitions="112,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="实际文件名" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Incoming.ActualFilename}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="状态" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Incoming.RegistrationText}" />
                        <TextBlock Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="大小" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Incoming.SizeText}" />
                        <TextBlock Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="修改时间" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Incoming.ModifiedText}" />
                        <TextBlock Grid.Row="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="媒体属性" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.Incoming.TechnicalText}" />
                        <TextBlock Grid.Row="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="作者" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.Incoming.AuthorsText}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="系列" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.Incoming.SeriesText}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="7" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="标签" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.Incoming.TagsText}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ExistingPane" Grid.Column="1" RowDefinitions="Auto,150,*" RowSpacing="10">
                <StackPanel>
                    <TextBlock
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="文件库中的匹配项" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="选择一个文件进行对比；替换只会作用于所选文件。"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ListView
                    x:Name="MatchList"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="ConflictMatchList"
                    AutomationProperties.Name="重复文件匹配列表"
                    ItemsSource="{x:Bind ViewModel.Matches}"
                    SelectedItem="{x:Bind ViewModel.SelectedMatch, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:ConflictMediaViewModel">
                            <Grid Padding="6" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ActualFilename}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Padding="7,3"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="9">
                                    <TextBlock FontSize="12" Text="{x:Bind ReasonText}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <controls:MediaPreviewControl
                            MinHeight="220"
                            Descriptor="{x:Bind ViewModel.SelectedMatch.Preview, Mode=OneWay}" />
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.SelectedMatch.DisplayName, Mode=OneWay}" />
                        <Grid ColumnDefinitions="112,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="实际文件名" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedMatch.ActualFilename, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="登记状态" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedMatch.RegistrationText, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="冲突原因" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedMatch.ReasonText, Mode=OneWay}" />
                            <TextBlock Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="大小" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedMatch.SizeText, Mode=OneWay}" />
                            <TextBlock Grid.Row="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="修改时间" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.SelectedMatch.ModifiedText, Mode=OneWay}" />
                            <TextBlock Grid.Row="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="媒体属性" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.SelectedMatch.TechnicalText, Mode=OneWay}" />
                            <TextBlock Grid.Row="6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="作者" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.SelectedMatch.AuthorsText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="7" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="系列" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.SelectedMatch.SeriesText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="标签" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{x:Bind ViewModel.SelectedMatch.TagsText, Mode=OneWay}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,18,0,0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="关闭或按 Esc 将保留冲突，稍后仍可重新处理。" />
            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="ConflictSkipButton"
                AutomationProperties.Name="跳过冲突文件"
                Click="OnSkipClicked"
                Content="跳过" />
            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="ConflictKeepBothButton"
                AutomationProperties.Name="保留两个文件"
                Click="OnKeepBothClicked"
                Content="两者都保留" />
            <Button
                Grid.Column="3"
                AutomationProperties.AutomationId="ConflictReplaceButton"
                AutomationProperties.HelpText="先选择可以替换的已有文件"
                AutomationProperties.Name="替换选中的已有文件"
                Click="OnReplaceClicked"
                Content="替换所选文件"
                IsEnabled="{x:Bind ViewModel.CanReplace, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</ContentDialog>
