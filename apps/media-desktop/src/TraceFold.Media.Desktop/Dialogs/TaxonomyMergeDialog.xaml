<ContentDialog
    x:Class="TraceFold.Media.Desktop.Dialogs.TaxonomyMergeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:TraceFold.Media.Desktop.Dialogs"
    xmlns:metadata="using:TraceFold.Media.Application.Metadata"
    MinWidth="0"
    AutomationProperties.AutomationId="TaxonomyMergeDialog"
    AutomationProperties.Name="合并词条预览与确认"
    DefaultButton="None"
    Loaded="OnLoaded"
    Title="合并词条">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1240</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
    </ContentDialog.Resources>

    <Grid x:Name="DialogRoot" RowDefinitions="*,Auto" RowSpacing="14">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactDialogLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SourcePane.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="TargetPane.(Grid.Row)" Value="1" />
                        <Setter Target="TargetPane.(Grid.Column)" Value="0" />
                        <Setter Target="TargetPane.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="PreviewPane.(Grid.Row)" Value="2" />
                        <Setter Target="PreviewPane.(Grid.Column)" Value="0" />
                        <Setter Target="PreviewPane.(Grid.ColumnSpan)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideDialogLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SourcePane.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="TargetPane.(Grid.Row)" Value="0" />
                        <Setter Target="TargetPane.(Grid.Column)" Value="1" />
                        <Setter Target="TargetPane.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="PreviewPane.(Grid.Row)" Value="0" />
                        <Setter Target="PreviewPane.(Grid.Column)" Value="2" />
                        <Setter Target="PreviewPane.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer
            x:Name="TaxonomyMergeScrollRoot"
            AutomationProperties.AutomationId="TaxonomyMergeScrollRoot"
            AutomationProperties.Name="词条合并预览滚动区域"
            VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="250,310,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">
            <Border
                x:Name="SourcePane"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="源词条" />
                    <TextBlock
                        Grid.Row="1"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="目标会自动从来源中移除。"
                        TextWrapping="Wrap" />
                    <ListView
                        Grid.Row="2"
                        AutomationProperties.AutomationId="TaxonomyMergeSources"
                        AutomationProperties.Name="将被合并并删除的源词条"
                        IsItemClickEnabled="False"
                        IsTabStop="False"
                        ItemsSource="{x:Bind ViewModel.Sources, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="metadata:TaxonomyManagementTermDto">
                                <Grid Padding="7,6" ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ReferenceCount}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                x:Name="TargetPane"
                Grid.Column="1"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="目标词条" />
                    <AutoSuggestBox
                        x:Name="TargetSearchBox"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="TaxonomyMergeTargetSearch"
                        AutomationProperties.Name="搜索现有同类目标词条"
                        PlaceholderText="搜索现有词条"
                        QueryIcon="Find"
                        TextChanged="OnTargetSearchTextChanged" />
                    <ListView
                        x:Name="TargetResultsList"
                        Grid.Row="2"
                        MinHeight="180"
                        AutomationProperties.AutomationId="TaxonomyMergeTargetResults"
                        AutomationProperties.Name="选择合并目标词条"
                        ItemsSource="{x:Bind ViewModel.TargetResults, Mode=OneWay}"
                        SelectionChanged="OnTargetSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="metadata:TaxonomyManagementTermDto">
                                <Grid Padding="7,6" ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ReferenceCount}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ToggleSwitch
                        Grid.Row="3"
                        AutomationProperties.AutomationId="TaxonomyMergeRenameToggle"
                        AutomationProperties.Name="同时修改目标词条显示名称"
                        Header="最终名称"
                        IsOn="{x:Bind ViewModel.RenameTarget, Mode=TwoWay}"
                        OffContent="保留目标原名称"
                        OnContent="使用新名称" />
                    <TextBox
                        x:Name="FinalNameInput"
                        Grid.Row="4"
                        AutomationProperties.AutomationId="TaxonomyMergeFinalName"
                        AutomationProperties.Name="输入目标词条最终显示名称"
                        IsEnabled="{x:Bind ViewModel.RenameTarget, Mode=OneWay}"
                        PlaceholderText="最终显示名称"
                        Text="{x:Bind ViewModel.FinalNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <Border
                x:Name="PreviewPane"
                Grid.Column="2"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="影响预览" />
                    <Grid
                        Grid.Row="1"
                        AutomationProperties.AutomationId="TaxonomyMergeAffectedSummary"
                        AutomationProperties.Name="受影响资料数量摘要"
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="8">
                        <Border Padding="9" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="待入库" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind ViewModel.AffectedInboxCount, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="9" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="正式库" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind ViewModel.AffectedLibraryCount, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="9" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="合计" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind ViewModel.AffectedTotalCount, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ListView
                        x:Name="AffectedFilesList"
                        Grid.Row="2"
                        AutomationProperties.AutomationId="TaxonomyMergeAffectedFiles"
                        AutomationProperties.Name="逐项受影响资料的合并前后预览"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.PreviewDisplayRows, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dialogs:TaxonomyMergePreviewDisplayRow">
                                <Grid Padding="8" RowDefinitions="Auto,Auto" RowSpacing="5">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Border Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                                            <TextBlock FontSize="11" Text="{x:Bind LocationLabel}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind VisibleName}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="7">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="合并前" />
                                            <TextBlock Text="{x:Bind BeforeSummary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" FontSize="12" Glyph="&#xE72A;" />
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="合并后" />
                                            <TextBlock Text="{x:Bind AfterSummary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Spacing="8">
            <Border
                Padding="12,9"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <FontIcon FontSize="16" Glyph="&#xE7BA;" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="仅修改软件资料，不修改实际文件" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="引用迁移、源词条删除和目标名称更新会在一个事务中完成。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock
                AutomationProperties.AutomationId="TaxonomyMergeStatus"
                AutomationProperties.Name="合并预览和执行状态"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="TaxonomyMergeCancelButton"
                AutomationProperties.Name="取消合并词条"
                Click="OnCancelClicked"
                Content="取消" />
            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="TaxonomyMergeApplyButton"
                AutomationProperties.HelpText="请先选择有效的目标词条并检查合并预览"
                AutomationProperties.Name="确认应用词条合并"
                Click="OnApplyClicked"
                Content="确认合并"
                IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
        </StackPanel>
    </Grid>
</ContentDialog>
