<ContentDialog
    x:Class="TraceFold.Media.Desktop.Dialogs.BatchMetadataDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:TraceFold.Media.Desktop.Dialogs"
    MinWidth="0"
    AutomationProperties.AutomationId="BatchMetadataDialog"
    AutomationProperties.Name="批量编辑资料"
    Closing="OnClosing"
    DefaultButton="None"
    Loaded="OnLoaded"
    Title="批量编辑资料">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
    </ContentDialog.Resources>

    <Grid x:Name="DialogRoot" RowDefinitions="*,Auto,Auto" RowSpacing="12">
        <ScrollViewer
            x:Name="BatchMetadataScrollRoot"
            AutomationProperties.AutomationId="BatchMetadataScrollRoot"
            AutomationProperties.Name="批量资料编辑滚动区域"
            VerticalScrollBarVisibility="Auto">
        <TabView
            x:Name="ModeTabs"
            CanDragTabs="False"
            IsAddTabButtonVisible="False"
            SelectionChanged="OnModeTabSelectionChanged">
            <TabViewItem
                AutomationProperties.AutomationId="BatchMetadataAddTab"
                AutomationProperties.Name="添加资料"
                Header="添加">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="4,12" Spacing="10">
                        <TextBlock Text="作者" FontWeight="SemiBold" />
                        <AutoSuggestBox
                            x:Name="AddAuthorInput"
                            AutomationProperties.AutomationId="BatchMetadataAddAuthorInput"
                            AutomationProperties.Name="输入要添加的作者"
                            ItemsSource="{x:Bind ViewModel.AddAuthorPicker.Suggestions, Mode=OneWay}"
                            PlaceholderText="输入名称后按 Enter"
                            QuerySubmitted="OnPickerQuerySubmitted"
                            Tag="{x:Bind ViewModel.AddAuthorPicker}"
                            Text="{x:Bind ViewModel.AddAuthorPicker.InputText, Mode=TwoWay}"
                            TextChanged="OnPickerTextChanged" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AddAuthorPicker.SelectedChoices, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:BatchTaxonomyChoiceViewModel">
                                    <Grid Margin="0,2" ColumnDefinitions="*,Auto">
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayText}" />
                                        <Button Grid.Column="1" Click="OnRemoveChoiceClicked" Content="移除" Tag="{x:Bind Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="内容标签" FontWeight="SemiBold" />
                        <AutoSuggestBox
                            AutomationProperties.AutomationId="BatchMetadataAddTagInput"
                            AutomationProperties.Name="输入要添加的标签"
                            ItemsSource="{x:Bind ViewModel.AddTagPicker.Suggestions, Mode=OneWay}"
                            PlaceholderText="输入名称后按 Enter"
                            QuerySubmitted="OnPickerQuerySubmitted"
                            Tag="{x:Bind ViewModel.AddTagPicker}"
                            Text="{x:Bind ViewModel.AddTagPicker.InputText, Mode=TwoWay}"
                            TextChanged="OnPickerTextChanged" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AddTagPicker.SelectedChoices, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:BatchTaxonomyChoiceViewModel">
                                    <Grid Margin="0,2" ColumnDefinitions="*,Auto">
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayText}" />
                                        <Button Grid.Column="1" Click="OnRemoveChoiceClicked" Content="移除" Tag="{x:Bind Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem
                AutomationProperties.AutomationId="BatchMetadataRemoveTab"
                AutomationProperties.Name="移除资料"
                Header="移除">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="4,12" Spacing="10">
                        <TextBlock Text="只列出当前选择中已使用的资料。" TextWrapping="Wrap" />
                        <TextBlock Text="作者" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RemoveAuthors, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:BatchTermCoverageOptionViewModel">
                                    <CheckBox Content="{x:Bind DisplayText}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="内容标签" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RemoveTags, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:BatchTermCoverageOptionViewModel">
                                    <CheckBox Content="{x:Bind DisplayText}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem
                AutomationProperties.AutomationId="BatchMetadataReplaceTab"
                AutomationProperties.Name="替换资料"
                Header="替换">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="4,12" Spacing="12">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                            <CheckBox
                                AutomationProperties.AutomationId="BatchReplaceAuthorsEnabled"
                                AutomationProperties.Name="启用替换作者"
                                Content="替换作者"
                                IsChecked="{x:Bind ViewModel.ReplaceAuthorsEnabled, Mode=TwoWay}" />
                            <CheckBox
                                Grid.Column="1"
                                AutomationProperties.AutomationId="BatchReplaceAuthorsClear"
                                AutomationProperties.Name="清空作者"
                                Content="明确清空"
                                IsChecked="{x:Bind ViewModel.ClearAuthors, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.ReplaceAuthorsEnabled, Mode=OneWay}" />
                        </Grid>
                        <AutoSuggestBox
                            AutomationProperties.Name="输入替换后的作者"
                            IsEnabled="{x:Bind ViewModel.ReplaceAuthorsInputEnabled, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.ReplaceAuthorPicker.Suggestions, Mode=OneWay}"
                            PlaceholderText="输入名称后按 Enter"
                            QuerySubmitted="OnPickerQuerySubmitted"
                            Tag="{x:Bind ViewModel.ReplaceAuthorPicker}"
                            Text="{x:Bind ViewModel.ReplaceAuthorPicker.InputText, Mode=TwoWay}"
                            TextChanged="OnPickerTextChanged" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ReplaceAuthorPicker.SelectedChoices, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:BatchTaxonomyChoiceViewModel">
                                    <Grid Margin="0,2" ColumnDefinitions="*,Auto">
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayText}" />
                                        <Button Grid.Column="1" Click="OnRemoveChoiceClicked" Content="移除" Tag="{x:Bind Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                            <CheckBox
                                AutomationProperties.AutomationId="BatchReplaceSeriesEnabled"
                                AutomationProperties.Name="启用替换系列"
                                Content="替换系列"
                                IsChecked="{x:Bind ViewModel.ReplaceSeriesEnabled, Mode=TwoWay}" />
                            <CheckBox
                                Grid.Column="1"
                                AutomationProperties.AutomationId="BatchReplaceSeriesClear"
                                AutomationProperties.Name="清空系列"
                                Content="明确清空"
                                IsChecked="{x:Bind ViewModel.ClearSeries, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.ReplaceSeriesEnabled, Mode=OneWay}" />
                        </Grid>
                        <AutoSuggestBox
                            AutomationProperties.Name="输入替换后的系列"
                            IsEnabled="{x:Bind ViewModel.ReplaceSeriesInputEnabled, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.ReplaceSeriesPicker.Suggestions, Mode=OneWay}"
                            PlaceholderText="输入名称后按 Enter"
                            QuerySubmitted="OnPickerQuerySubmitted"
                            Tag="{x:Bind ViewModel.ReplaceSeriesPicker}"
                            Text="{x:Bind ViewModel.ReplaceSeriesPicker.InputText, Mode=TwoWay}"
                            TextChanged="OnPickerTextChanged" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ReplaceSeriesPicker.SelectedChoices, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:BatchTaxonomyChoiceViewModel">
                                    <Grid Margin="0,2" ColumnDefinitions="*,Auto">
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayText}" />
                                        <Button Grid.Column="1" Click="OnRemoveChoiceClicked" Content="移除" Tag="{x:Bind Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                            <CheckBox
                                AutomationProperties.AutomationId="BatchReplaceTagsEnabled"
                                AutomationProperties.Name="启用替换标签"
                                Content="替换内容标签"
                                IsChecked="{x:Bind ViewModel.ReplaceTagsEnabled, Mode=TwoWay}" />
                            <CheckBox
                                Grid.Column="1"
                                AutomationProperties.AutomationId="BatchReplaceTagsClear"
                                AutomationProperties.Name="清空标签"
                                Content="明确清空"
                                IsChecked="{x:Bind ViewModel.ClearTags, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.ReplaceTagsEnabled, Mode=OneWay}" />
                        </Grid>
                        <AutoSuggestBox
                            AutomationProperties.Name="输入替换后的标签"
                            IsEnabled="{x:Bind ViewModel.ReplaceTagsInputEnabled, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.ReplaceTagPicker.Suggestions, Mode=OneWay}"
                            PlaceholderText="输入名称后按 Enter"
                            QuerySubmitted="OnPickerQuerySubmitted"
                            Tag="{x:Bind ViewModel.ReplaceTagPicker}"
                            Text="{x:Bind ViewModel.ReplaceTagPicker.InputText, Mode=TwoWay}"
                            TextChanged="OnPickerTextChanged" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ReplaceTagPicker.SelectedChoices, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:BatchTaxonomyChoiceViewModel">
                                    <Grid Margin="0,2" ColumnDefinitions="*,Auto">
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayText}" />
                                        <Button Grid.Column="1" Click="OnRemoveChoiceClicked" Content="移除" Tag="{x:Bind Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
        </ScrollViewer>

        <TextBlock
            Grid.Row="1"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            TextWrapping="Wrap" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="关闭或按 Esc 不会修改任何资料。" />
            <Button Grid.Column="1" Click="OnCancelClicked" Content="取消" />
            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="BatchMetadataSubmitButton"
                AutomationProperties.HelpText="请先填写有效的批量资料修改"
                AutomationProperties.Name="提交批量资料修改"
                Click="OnSubmitClicked"
                Content="应用修改"
                IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</ContentDialog>
