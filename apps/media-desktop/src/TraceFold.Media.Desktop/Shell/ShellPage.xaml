<Page
    x:Class="TraceFold.Media.Desktop.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="ShellRoot"
        AutomationProperties.AutomationId="TraceFoldShell"
        AutomationProperties.Name="主导航工作区"
        RowDefinitions="Auto,*">
        <InfoBar
            x:Name="StartupInfoBar"
            Margin="12,12,12,0"
            AutomationProperties.AutomationId="StartupInfoBar"
            AutomationProperties.Name="启动状态提示"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsStartupInfoBarOpen, Mode=OneWay}"
            Message="{x:Bind ViewModel.StartupMessage, Mode=OneWay}" />

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="{StaticResource TraceFoldNavigationOpenPaneWidth}"
            CompactPaneLength="{StaticResource TraceFoldNavigationCompactPaneWidth}"
            PaneDisplayMode="Left"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavInbox"
                    AutomationProperties.Name="待入库导航"
                    Content="待入库"
                    Icon="Folder"
                    Tag="inbox" />
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavLibrary"
                    AutomationProperties.Name="正式文件库导航"
                    Content="正式文件库"
                    Icon="Library"
                    Tag="library" />
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavTaxonomy"
                    AutomationProperties.Name="词表管理导航"
                    Content="词表管理"
                    Icon="Bullets"
                    Tag="taxonomy" />
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavSettings"
                    AutomationProperties.Name="设置导航"
                    Content="设置"
                    Icon="Setting"
                    Tag="settings" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Page>
