<Page
    x:Class="TraceFold.Media.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:TraceFold.Media.Desktop.Pages"
    xmlns:settings="using:TraceFold.Media.Application.Settings">
    <Grid AutomationProperties.AutomationId="SettingsPageRoot" AutomationProperties.Name="设置工作区">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SettingsFolderFormLayout">
                <VisualState x:Name="CompactFolderRows">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InboxFolderPath.(Grid.Row)" Value="1" />
                        <Setter Target="InboxFolderPath.(Grid.Column)" Value="0" />
                        <Setter Target="InboxFolderPath.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="PickInboxFolderButton.(Grid.Row)" Value="2" />
                        <Setter Target="PickInboxFolderButton.(Grid.Column)" Value="0" />
                        <Setter Target="PickInboxFolderButton.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="LibraryFolderPath.(Grid.Row)" Value="1" />
                        <Setter Target="LibraryFolderPath.(Grid.Column)" Value="0" />
                        <Setter Target="LibraryFolderPath.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="PickLibraryFolderButton.(Grid.Row)" Value="2" />
                        <Setter Target="PickLibraryFolderButton.(Grid.Column)" Value="0" />
                        <Setter Target="PickLibraryFolderButton.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="WorkFolderPath.(Grid.Row)" Value="1" />
                        <Setter Target="WorkFolderPath.(Grid.Column)" Value="0" />
                        <Setter Target="WorkFolderPath.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="PickWorkFolderButton.(Grid.Row)" Value="2" />
                        <Setter Target="PickWorkFolderButton.(Grid.Column)" Value="0" />
                        <Setter Target="PickWorkFolderButton.(Grid.ColumnSpan)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideFolderRows">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InboxFolderPath.(Grid.Row)" Value="0" />
                        <Setter Target="InboxFolderPath.(Grid.Column)" Value="1" />
                        <Setter Target="InboxFolderPath.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="PickInboxFolderButton.(Grid.Row)" Value="0" />
                        <Setter Target="PickInboxFolderButton.(Grid.Column)" Value="2" />
                        <Setter Target="PickInboxFolderButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="LibraryFolderPath.(Grid.Row)" Value="0" />
                        <Setter Target="LibraryFolderPath.(Grid.Column)" Value="1" />
                        <Setter Target="LibraryFolderPath.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="PickLibraryFolderButton.(Grid.Row)" Value="0" />
                        <Setter Target="PickLibraryFolderButton.(Grid.Column)" Value="2" />
                        <Setter Target="PickLibraryFolderButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="WorkFolderPath.(Grid.Row)" Value="0" />
                        <Setter Target="WorkFolderPath.(Grid.Column)" Value="1" />
                        <Setter Target="WorkFolderPath.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="PickWorkFolderButton.(Grid.Row)" Value="0" />
                        <Setter Target="PickWorkFolderButton.(Grid.Column)" Value="2" />
                        <Setter Target="PickWorkFolderButton.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TabView
            x:Name="SettingsTabs"
            AutomationProperties.AutomationId="SettingsTabs"
            AutomationProperties.Name="设置分类"
            IsAddTabButtonVisible="False"
            SelectedIndex="0"
            SelectionChanged="OnSettingsTabSelectionChanged">
            <TabViewItem
                x:Name="FolderSettingsTab"
                AutomationProperties.AutomationId="FolderSettingsTab"
                AutomationProperties.Name="文件夹设置选项卡"
                Header="文件夹与扫描"
                HorizontalContentAlignment="Stretch"
                IsClosable="False"
                VerticalContentAlignment="Stretch">
                <ScrollViewer>
                    <StackPanel
                        x:Name="SettingsFolderForm"
                        AutomationProperties.AutomationId="SettingsFolderForm"
                        AutomationProperties.Name="文件夹设置表单"
                        MaxWidth="900"
                        Padding="{StaticResource TraceFoldPagePadding}"
                        HorizontalAlignment="Stretch"
                        Spacing="24">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="文件夹设置" />
                            <TextBlock
                                Opacity="0.72"
                                Text="选择待入库、正式文件库和前置处理工作目录。三个目录不能相同或互相包含。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock VerticalAlignment="Center" Text="待入库目录" />
                            <TextBox
                                x:Name="InboxFolderPath"
                                Grid.Column="1"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="InboxFolderPath"
                                AutomationProperties.Name="待入库文件夹路径"
                                IsReadOnly="True"
                                PlaceholderText="请选择待入库目录"
                                Text="{x:Bind ViewModel.InboxDirectory, Mode=OneWay}" />
                            <Button
                                x:Name="PickInboxFolderButton"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="PickInboxFolder"
                                AutomationProperties.Name="选择待入库文件夹"
                                Command="{x:Bind ViewModel.ChooseInboxCommand}"
                                Content="选择…" />
                        </Grid>

                        <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock VerticalAlignment="Center" Text="正式文件库" />
                            <TextBox
                                x:Name="LibraryFolderPath"
                                Grid.Column="1"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="LibraryFolderPath"
                                AutomationProperties.Name="正式文件库路径"
                                IsReadOnly="True"
                                PlaceholderText="请选择正式文件库目录"
                                Text="{x:Bind ViewModel.LibraryDirectory, Mode=OneWay}" />
                            <Button
                                x:Name="PickLibraryFolderButton"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="PickLibraryFolder"
                                AutomationProperties.Name="选择正式文件库文件夹"
                                Command="{x:Bind ViewModel.ChooseLibraryCommand}"
                                Content="选择…" />
                        </Grid>

                        <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock VerticalAlignment="Center" Text="工作目录" />
                            <TextBox
                                x:Name="WorkFolderPath"
                                Grid.Column="1"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="WorkFolderPath"
                                AutomationProperties.Name="工作文件夹路径"
                                IsReadOnly="True"
                                PlaceholderText="请选择前置处理工作目录"
                                Text="{x:Bind ViewModel.WorkDirectory, Mode=OneWay}" />
                            <Button
                                x:Name="PickWorkFolderButton"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="PickWorkFolder"
                                AutomationProperties.Name="选择工作文件夹"
                                Command="{x:Bind ViewModel.ChooseWorkCommand}"
                                Content="选择…" />
                        </Grid>

                        <Border
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock FontWeight="SemiBold" Text="待入库监测" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="LastScanStatus"
                                        AutomationProperties.Name="上次扫描状态"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.LastScanAtText, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.LastScanSummary, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AutoScanToggle"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="AutoScanToggle"
                                    AutomationProperties.Name="自动扫描开关"
                                    Header="自动扫描"
                                    IsOn="{x:Bind ViewModel.AutoScanEnabled, Mode=OneWay}"
                                    OffContent="已关闭"
                                    OnContent="每 5 秒检查一次"
                                    Toggled="OnAutoScanToggled" />
                            </Grid>
                        </Border>

                        <Border
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="前置处理工具" />
                                <TextBlock
                                    AutomationProperties.AutomationId="ProcessingToolStatus"
                                    AutomationProperties.Name="处理工具状态"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.ProcessingToolStatus, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl
                            AutomationProperties.AutomationId="SettingsValidationErrors"
                            AutomationProperties.Name="设置验证错误"
                            ItemsSource="{x:Bind ViewModel.Errors, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="settings:SettingsError">
                                    <TextBlock
                                        Margin="0,2"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Text="{x:Bind Message}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                AutomationProperties.AutomationId="SaveFolderSettings"
                                AutomationProperties.Name="保存文件夹设置"
                                Command="{x:Bind ViewModel.SaveCommand}"
                                Content="保存设置"
                                Style="{ThemeResource AccentButtonStyle}" />
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="SettingsStatusMessage"
                                AutomationProperties.Name="设置状态消息"
                                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem
                x:Name="SystemDiagnosticsTab"
                AutomationProperties.AutomationId="SystemDiagnosticsTab"
                AutomationProperties.Name="系统诊断选项卡"
                Header="系统诊断"
                HorizontalContentAlignment="Stretch"
                IsClosable="False"
                VerticalContentAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="980" Padding="32" HorizontalAlignment="Left" Spacing="18">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <StackPanel Spacing="6">
                                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="系统诊断" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="16"
                                        Glyph="{x:Bind DiagnosticsViewModel.OverallIconGlyph, Mode=OneWay}" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="DiagnosticsOverallStatus"
                                        AutomationProperties.Name="系统诊断总体状态"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind DiagnosticsViewModel.OverallStatusText, Mode=OneWay}" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="DiagnosticsLastChecked"
                                        AutomationProperties.Name="系统诊断上次检查时间"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind DiagnosticsViewModel.LastCheckedText, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="结果基于已保存设置"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    IsActive="{x:Bind DiagnosticsViewModel.IsRunning, Mode=OneWay}" />
                                <Button
                                    AutomationProperties.AutomationId="DiagnosticsRefreshButton"
                                    AutomationProperties.Name="重新运行系统诊断"
                                    Command="{x:Bind DiagnosticsViewModel.RefreshCommand}"
                                    Content="重新检查" />
                                <Button
                                    AutomationProperties.AutomationId="DiagnosticsCopySummaryButton"
                                    AutomationProperties.Name="复制系统诊断摘要"
                                    Command="{x:Bind DiagnosticsViewModel.CopySummaryCommand}"
                                    Content="复制摘要" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind DiagnosticsViewModel.RunStatusText, Mode=OneWay}" />
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind DiagnosticsViewModel.HasPageMessage, Mode=OneWay}"
                            Message="{x:Bind DiagnosticsViewModel.PageMessage, Mode=OneWay}"
                            Severity="Warning" />

                        <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.Groups, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pages:SystemDiagnosticGroupViewModel">
                                    <Border
                                        x:Name="DiagnosticGroupRoot"
                                        Margin="0,0,0,12"
                                        Padding="16"
                                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                        AutomationProperties.Name="{x:Bind AccessibleName}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <FontIcon FontSize="15" Glyph="{x:Bind IconGlyph}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Title}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind StatusText}" />
                                            </Grid>

                                            <ItemsControl ItemsSource="{x:Bind Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="pages:SystemDiagnosticItemViewModel">
                                                        <Border
                                                            x:Name="DiagnosticItemRoot"
                                                            Padding="12"
                                                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                            AutomationProperties.Name="{x:Bind AccessibleName}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="0,1,0,0">
                                                            <StackPanel Spacing="8">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                    <FontIcon FontSize="14" Glyph="{x:Bind IconGlyph}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        FontWeight="SemiBold"
                                                                        Text="{x:Bind Title}"
                                                                        TextWrapping="Wrap" />
                                                                    <TextBlock
                                                                        Grid.Column="2"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind StatusText}" />
                                                                </Grid>
                                                                <TextBlock Text="{x:Bind Conclusion}" TextWrapping="Wrap" />

                                                                <StackPanel
                                                                    x:Name="DiagnosticIssueDetails"
                                                                    Spacing="7"
                                                                    Visibility="{x:Bind DetailsVisibility}">
                                                                    <TextBlock Text="{x:Bind Impact}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{x:Bind Guidance}" TextWrapping="Wrap" />
                                                                    <TextBlock
                                                                        x:Name="DiagnosticErrorCode"
                                                                        AutomationProperties.AutomationId="{x:Bind ErrorCodeAutomationId}"
                                                                        AutomationProperties.Name="诊断错误代码"
                                                                        FontFamily="Consolas"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        IsTextSelectionEnabled="True"
                                                                        Text="{x:Bind ErrorCode}"
                                                                        TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <ItemsControl
                                                                    x:Name="DiagnosticFacts"
                                                                    ItemsSource="{x:Bind Facts}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="pages:SystemDiagnosticFactViewModel">
                                                                            <Grid Margin="0,2" ColumnDefinitions="160,*" ColumnSpacing="12">
                                                                                <TextBlock
                                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                    Text="{x:Bind Label}" />
                                                                                <TextBlock
                                                                                    Grid.Column="1"
                                                                                    Text="{x:Bind Value}"
                                                                                    TextWrapping="Wrap" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <ItemsControl
                                                                    x:Name="DiagnosticActions"
                                                                    ItemsSource="{x:Bind Actions}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="pages:SystemDiagnosticActionViewModel">
                                                                            <Button
                                                                                x:Name="DiagnosticActionButton"
                                                                                Margin="0,2,8,0"
                                                                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                                                AutomationProperties.Name="{x:Bind AutomationName}"
                                                                                Command="{x:Bind ExecuteCommand}"
                                                                                Content="{x:Bind Label}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
