<Page
    x:Class="TraceFold.Media.Desktop.Pages.TaxonomyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TraceFold.Media.Desktop.Controls"
    xmlns:metadata="using:TraceFold.Media.Application.Metadata"
    xmlns:pages="using:TraceFold.Media.Desktop.Pages">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="3">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="词表管理" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="查找重复词条、核对引用，并安全地合并或清理未使用词条。"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Border
                Grid.Column="1"
                Padding="10,5"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="12">
                <TextBlock Text="只修改资料 · 不修改文件" />
            </Border>
        </Grid>

        <InfoBar
            Grid.Row="1"
            AutomationProperties.AutomationId="TaxonomyUndoBanner"
            AutomationProperties.Name="最近一次词表维护可撤销提示"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.CanUndoMaintenance, Mode=OneWay}"
            Message="{x:Bind ViewModel.UndoBannerMessage, Mode=OneWay}"
            Severity="Informational"
            Title="词表已更新">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.AutomationId="TaxonomyUndoButton"
                    AutomationProperties.Name="撤销最近一次词表维护"
                    Click="OnUndoClicked"
                    Content="撤销"
                    IsEnabled="{x:Bind ViewModel.CanExecuteUndo, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <controls:ResponsiveInspectorHost
            x:Name="WorkspaceHost"
            Grid.Row="2"
            DrawerOpened="OnInspectorDrawerOpened"
            DrawerClosed="OnInspectorDrawerClosed"
            LayoutModeChanged="OnWorkspaceLayoutModeChanged">
            <controls:ResponsiveInspectorHost.PrimaryContent>
        <Grid
            ColumnDefinitions="176,12,*"
            MinHeight="480">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock
                        Margin="8,6,8,2"
                        FontWeight="SemiBold"
                        Text="词表类型" />
                    <ListView
                        x:Name="KindList"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="TaxonomyKindList"
                        AutomationProperties.Name="选择作者系列或内容标签"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.KindOptions, Mode=OneWay}"
                        SelectedIndex="0"
                        SelectionChanged="OnKindSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="pages:TaxonomyKindOption">
                                <Grid Padding="8,7">
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        AutomationProperties.AutomationId="TaxonomySearchBox"
                        AutomationProperties.Name="搜索当前词表名称"
                        PlaceholderText="搜索名称"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=OneWay}"
                        TextChanged="OnSearchTextChanged" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.AutomationId="TaxonomyRefreshButton"
                        AutomationProperties.Name="立即刷新词表"
                        Click="OnRefreshClicked"
                        Content="刷新" />
                    <Button
                        x:Name="TaxonomyInspectorOpenButton"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="TaxonomyInspectorOpenButton"
                        AutomationProperties.Name="打开词条详情面板"
                        Click="OnInspectorOpenClick"
                        Content="查看详情"
                        IsEnabled="{x:Bind ViewModel.Selection.HasSelection, Mode=OneWay}"
                        Visibility="Collapsed" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                    <ComboBox
                        x:Name="ReferenceFilterSelector"
                        AutomationProperties.AutomationId="TaxonomyReferenceFilter"
                        AutomationProperties.Name="按引用状态筛选词条"
                        Header="引用"
                        SelectedIndex="0"
                        SelectionChanged="OnReferenceFilterChanged">
                        <ComboBoxItem Content="全部" Tag="All" />
                        <ComboBoxItem Content="已引用" Tag="Referenced" />
                        <ComboBoxItem Content="未使用" Tag="Unused" />
                    </ComboBox>
                    <ComboBox
                        x:Name="SortFieldSelector"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="TaxonomySortField"
                        AutomationProperties.Name="选择词条排序字段"
                        Header="排序"
                        SelectedIndex="0"
                        SelectionChanged="OnSortChanged">
                        <ComboBoxItem Content="名称" Tag="DisplayName" />
                        <ComboBoxItem Content="引用数量" Tag="ReferenceCount" />
                    </ComboBox>
                    <ComboBox
                        x:Name="SortDirectionSelector"
                        Grid.Column="2"
                        MinWidth="92"
                        AutomationProperties.AutomationId="TaxonomySortDirection"
                        AutomationProperties.Name="选择词条排序方向"
                        Header="方向"
                        SelectedIndex="0"
                        SelectionChanged="OnSortChanged">
                        <ComboBoxItem Content="升序" Tag="Ascending" />
                        <ComboBoxItem Content="降序" Tag="Descending" />
                    </ComboBox>
                    <Button
                        Grid.Column="3"
                        Margin="0,24,0,0"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="TaxonomyCreateButton"
                        AutomationProperties.Name="新建当前类型词条"
                        Click="OnCreateClicked"
                        Content="新建"
                        IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}" />
                </Grid>

                <Border
                    Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ListView
                        x:Name="TermList"
                        AutomationProperties.AutomationId="TaxonomyTermList"
                        AutomationProperties.Name="当前查询的词条列表"
                        ItemsSource="{x:Bind ViewModel.Terms, Mode=OneWay}"
                        SelectionChanged="OnTermSelectionChanged"
                        SelectionMode="Extended">
                        <ListView.KeyboardAccelerators>
                            <KeyboardAccelerator
                                Key="A" Modifiers="Control"
                                Invoked="OnSelectAllAccelerator" />
                            <KeyboardAccelerator
                                Key="Escape"
                                Invoked="OnClearSelectionAccelerator" />
                        </ListView.KeyboardAccelerators>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="metadata:TaxonomyManagementTermDto">
                                <Grid Padding="10,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind DisplayName}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind NormalizedName}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        Padding="9,4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <TextBlock Text="{x:Bind ReferenceCount}" />
                                            <TextBlock Text="项引用" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <TextBlock
                    Grid.Row="3"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Grid>

        </Grid>
        </controls:ResponsiveInspectorHost.PrimaryContent>
        <controls:ResponsiveInspectorHost.InspectorContent>
            <Border
                Padding="18"
                AutomationProperties.AutomationId="TaxonomyInspectorPane"
                AutomationProperties.Name="词条详情和维护操作"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Border.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" Invoked="OnClearSelectionAccelerator" />
                </Border.KeyboardAccelerators>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock
                                x:Name="TaxonomyInspectorHeading"
                                AutomationProperties.AutomationId="TaxonomyInspectorHeading"
                                AutomationProperties.Name="词条详情标题"
                                IsTabStop="True"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="详情" />
                            <Button
                                x:Name="TaxonomyInspectorCloseButton"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="TaxonomyInspectorCloseButton"
                                AutomationProperties.Name="关闭词条详情面板"
                                Click="OnInspectorCloseClick"
                                Content="关闭"
                                Visibility="Collapsed" />
                        </Grid>

                        <StackPanel
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.EmptyInspectorVisibility, Mode=OneWay}">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="选择词条以查看引用和维护操作。"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="支持 Ctrl 多选、Shift 连选、Ctrl+A 全选和 Esc 清空。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.SingleInspectorVisibility, Mode=OneWay}">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.SelectedDisplayName, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.SelectedKindDisplayName, Mode=OneWay}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                                <TextBlock Text="待入库引用" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedTermInboxReferenceCount, Mode=OneWay}" />
                                <TextBlock Grid.Row="1" Text="正式库引用" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedTermLibraryReferenceCount, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="总引用" />
                                <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedTermReferenceCount, Mode=OneWay}" />
                            </Grid>
                            <Button
                                AutomationProperties.AutomationId="TaxonomyRenameButton"
                                AutomationProperties.Name="重命名所选词条"
                                Click="OnRenameClicked"
                                Content="重命名"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.CanRename, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.MultipleInspectorVisibility, Mode=OneWay}">
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="多项选择" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" />
                                    <TextBlock Text="个词条" />
                                </StackPanel>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                                <TextBlock Text="待入库引用合计" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedInboxReferenceCount, Mode=OneWay}" />
                                <TextBlock Grid.Row="1" Text="正式库引用合计" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedLibraryReferenceCount, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="总引用合计" />
                                <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedReferenceCount, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel
                            AutomationProperties.AutomationId="TaxonomyDeleteBlockers"
                            AutomationProperties.Name="阻止删除的已引用词条"
                            Spacing="6"
                            Visibility="{x:Bind ViewModel.DeleteBlockersVisibility, Mode=OneWay}">
                            <TextBlock FontWeight="SemiBold" Text="无法删除" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="以下词条仍被资料引用；删除采用整批阻止。"
                                TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DeleteBlockers, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="metadata:TaxonomyManagementTermDto">
                                        <Grid Margin="0,3" ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ReferenceCount}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Button
                                AutomationProperties.AutomationId="TaxonomyMergeButton"
                                AutomationProperties.Name="合并所选词条"
                                Click="OnMergeClicked"
                                Content="合并…"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.CanMerge, Mode=OneWay}" />
                            <Button
                                AutomationProperties.AutomationId="TaxonomyDeleteButton"
                                AutomationProperties.Name="删除所选未使用词条"
                                Click="OnDeleteClicked"
                                Content="删除"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.CanDeleteSelection, Mode=OneWay}" />
                        </StackPanel>

                        <Border
                            Padding="12"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Visibility="{x:Bind ViewModel.RenameConflictVisibility, Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="同名词条已存在。可以将当前词条合并到该词条。"
                                    TextWrapping="Wrap" />
                                <Button
                                    AutomationProperties.AutomationId="TaxonomyRenameConflictMergeButton"
                                    AutomationProperties.Name="将重命名冲突改为合并"
                                    Click="OnMergeClicked"
                                    Content="改为合并"
                                    IsEnabled="{x:Bind ViewModel.CanMergeRenameConflict, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </controls:ResponsiveInspectorHost.InspectorContent>
        </controls:ResponsiveInspectorHost>
    </Grid>
</Page>
