<Page
    x:Class="TraceFold.Media.Desktop.Pages.InboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TraceFold.Media.Desktop.Controls"
    xmlns:pages="using:TraceFold.Media.Desktop.Pages">
    <controls:ResponsiveInspectorHost
        x:Name="WorkspaceHost"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        DrawerOpened="OnInspectorDrawerOpened"
        DrawerClosed="OnInspectorDrawerClosed"
        LayoutModeChanged="OnWorkspaceLayoutModeChanged">
        <controls:ResponsiveInspectorHost.PrimaryContent>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
            <Grid Margin="24,18,20,8" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock
                        x:Name="InboxTitle"
                        AutomationProperties.AutomationId="InboxTitle"
                        AutomationProperties.Name="待入库页面标题"
                        IsTabStop="True"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="待入库" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="检查下载文件、补充资料，然后安全转入正式文件库。" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="InboxOperationStatus"
                    AutomationProperties.Name="待入库操作状态"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ScanStatusMessage, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid Grid.Row="1" Margin="24,8,20,14" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                <AutoSuggestBox
                    AutomationProperties.AutomationId="InboxSearchBox"
                    PlaceholderText="搜索文件名或显示名称"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                <ComboBox
                    Grid.Column="1"
                    MinWidth="150"
                    AutomationProperties.AutomationId="InboxStateFilter"
                    ItemsSource="{x:Bind ViewModel.StateFilters, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedStateFilter, Mode=TwoWay}" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.AutomationId="InboxRefreshButton"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Content="立即刷新" />
                <Button
                    x:Name="InboxInspectorOpenButton"
                    Grid.Column="3"
                    AutomationProperties.AutomationId="InboxInspectorOpenButton"
                    AutomationProperties.Name="打开待入库文件资料面板"
                    Click="OnInspectorOpenClick"
                    Content="查看资料"
                    IsEnabled="{x:Bind ViewModel.Selection.HasSelection, Mode=OneWay}"
                    Visibility="Collapsed" />
            </Grid>

            <Border
                Grid.Row="2"
                Margin="24,0,20,12"
                Padding="12,8"
                AutomationProperties.AutomationId="InboxBatchBar"
                AutomationProperties.Name="待入库批量操作栏"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="6"
                Visibility="{x:Bind ViewModel.BatchBarVisibility, Mode=OneWay}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                    <TextBlock VerticalAlignment="Center" Text="已选择" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Selection.SelectedCount, Mode=OneWay}" />
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button
                            AutomationProperties.AutomationId="InboxBatchMetadataButton"
                            AutomationProperties.Name="批量编辑所选文件的资料"
                            Command="{x:Bind ViewModel.BatchEditMetadataCommand}"
                            Content="批量编辑资料" />
                        <Button
                            AutomationProperties.AutomationId="InboxBatchStartProcessingButton"
                            AutomationProperties.Name="仅将适用的所选文件加入前置处理队列"
                            Command="{x:Bind ViewModel.BatchStartProcessingCommand}"
                            Content="开始前置处理" />
                        <Button
                            AutomationProperties.AutomationId="InboxBatchIngestButton"
                            AutomationProperties.Name="预览并确认批量入库"
                            Command="{x:Bind ViewModel.BatchIngestCommand}"
                            Content="批量入库"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <Button
                        Grid.Column="3"
                        AutomationProperties.AutomationId="InboxCancelSelectionButton"
                        AutomationProperties.Name="取消所有待入库选择"
                        Click="OnCancelSelectionClick"
                        Content="取消选择" />
                </Grid>
            </Border>

            <Grid
                Grid.Row="3"
                Margin="36,0,32,4"
                AutomationProperties.AutomationId="InboxListHeader"
                AutomationProperties.Name="待入库文件列表表头"
                ColumnDefinitions="32,*,160,110"
                ColumnSpacing="8"
                Style="{StaticResource TraceFoldMediaRowHeaderStyle}">
                <TextBlock Grid.Column="1" Text="显示名称" />
                <TextBlock Grid.Column="2" Text="实际文件名" />
                <TextBlock Grid.Column="3" Text="状态" />
            </Grid>

            <ListView
                x:Name="InboxGrid"
                Grid.Row="4"
                Margin="16,0,12,16"
                AutomationProperties.AutomationId="InboxGrid"
                AutomationProperties.Name="待入库文件列表"
                IsItemClickEnabled="True"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                ContainerContentChanging="OnInboxContainerContentChanging"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Extended"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                Style="{StaticResource TraceFoldMediaListStyle}">
                <ListView.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="A" Invoked="OnSelectAllAccelerator" />
                    <KeyboardAccelerator Key="Escape" Invoked="OnClearSelectionAccelerator" />
                </ListView.KeyboardAccelerators>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="pages:InboxCardViewModel">
                        <Grid
                            Height="{StaticResource TraceFoldFileRowHeight}"
                            ColumnDefinitions="32,*,160,110"
                            ColumnSpacing="8"
                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                            AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                            <Border
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <Grid>
                                    <Image
                                        Source="{x:Bind ThumbnailSource}"
                                        Stretch="UniformToFill"
                                        Visibility="{x:Bind ThumbnailVisibility}" />
                                    <FontIcon
                                        FontSize="16"
                                        Glyph="{x:Bind FallbackGlyph}"
                                        Visibility="{x:Bind FallbackVisibility}" />
                                </Grid>
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ActualFilename, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <Grid Grid.Column="3" RowDefinitions="*,Auto">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Grid.Row="1"
                                    FontSize="11"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{x:Bind ProgressText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ProcessingVisibility, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        </controls:ResponsiveInspectorHost.PrimaryContent>
        <controls:ResponsiveInspectorHost.InspectorContent>
        <Border
            Padding="20"
            AutomationProperties.AutomationId="InspectorPane"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <Border.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnClearSelectionAccelerator" />
            </Border.KeyboardAccelerators>
            <ScrollViewer>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock
                            x:Name="InboxInspectorHeading"
                            AutomationProperties.AutomationId="InboxInspectorHeading"
                            AutomationProperties.Name="待入库文件资料标题"
                            IsTabStop="True"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="资料" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Inspector.State, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.InspectorVisibility, Mode=OneWay}" />
                        <Button
                            x:Name="InboxInspectorCloseButton"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="InboxInspectorCloseButton"
                            AutomationProperties.Name="关闭待入库文件资料面板"
                            Click="OnInspectorCloseClick"
                            Content="关闭"
                            Visibility="Collapsed" />
                    </Grid>
                <StackPanel
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.InspectorVisibility, Mode=OneWay}">
                    <controls:MediaPreviewControl
                        x:Name="PreviewControl"
                        Descriptor="{x:Bind ViewModel.Inspector.Preview, Mode=OneWay}" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Inspector.ActualFilename, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Inspector.StatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Border
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="6"
                        Visibility="{x:Bind ViewModel.Inspector.ProcessingVisibility, Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.Inspector.ProcessorName, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.Inspector.ProcessingStatusText, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                AutomationProperties.AutomationId="InboxProcessingStep"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Inspector.ProcessingStepText, Mode=OneWay}" />
                            <ProgressBar
                                AutomationProperties.AutomationId="InboxProcessingProgress"
                                Maximum="100"
                                Value="{x:Bind ViewModel.Inspector.ProcessingProgressPercent, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Inspector.ErrorCode, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="6"
                        Visibility="{x:Bind ViewModel.Inspector.RecoveryVisibility, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.AutomationId="InboxRecoveryStatus"
                            Text="{x:Bind ViewModel.Inspector.RecoveryStatusText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Border>
                    <TextBox
                        AutomationProperties.AutomationId="DisplayNameBox"
                        Header="显示名称"
                        PlaceholderText="不修改实际文件名"
                        Text="{x:Bind ViewModel.Inspector.Metadata.DisplayName, Mode=TwoWay}" />
                    <TextBlock FontWeight="SemiBold" Text="作者" />
                    <controls:TaxonomyPickerControl
                        x:Name="AuthorPicker"
                        AutomationProperties.AutomationId="AuthorPicker"
                        InputAutomationId="InboxAuthorInput"
                        InputAutomationName="输入待入库资料的作者"
                        SelectedTermsAutomationId="InboxAuthorInputTerms"
                        SelectedTermsAutomationName="已添加的待入库资料作者"
                        SelectionChanged="OnAuthorSelectionChanged" />
                    <TextBlock FontWeight="SemiBold" Text="系列" />
                    <controls:TaxonomyPickerControl
                        x:Name="SeriesPicker"
                        InputAutomationId="InboxSeriesInput"
                        InputAutomationName="输入待入库资料的系列"
                        SelectedTermsAutomationId="InboxSeriesInputTerms"
                        SelectedTermsAutomationName="已添加的待入库资料系列"
                        SelectionChanged="OnSeriesSelectionChanged" />
                    <TextBlock FontWeight="SemiBold" Text="内容标签" />
                    <controls:TaxonomyPickerControl
                        x:Name="TagPicker"
                        InputAutomationId="InboxTagInput"
                        InputAutomationName="输入待入库资料的内容标签"
                        SelectedTermsAutomationId="InboxTagInputTerms"
                        SelectedTermsAutomationName="已添加的待入库资料内容标签"
                        SelectionChanged="OnTagSelectionChanged" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.OperationMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="IngestButton"
                        Command="{x:Bind ViewModel.IngestCommand}"
                        Content="正式入库"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="ResolveInboxConflictButton"
                        Command="{x:Bind ViewModel.ResolveConflictCommand}"
                        Content="处理冲突"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.Inspector.ResolveConflictVisibility, Mode=OneWay}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="InboxStartProcessingButton"
                        Command="{x:Bind ViewModel.StartProcessingCommand}"
                        Content="开始前置处理"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.Inspector.StartProcessingVisibility, Mode=OneWay}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="InboxCancelProcessingButton"
                        Command="{x:Bind ViewModel.CancelProcessingCommand}"
                        Content="取消排队"
                        Visibility="{x:Bind ViewModel.Inspector.CancelProcessingVisibility, Mode=OneWay}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="InboxStopProcessingButton"
                        Command="{x:Bind ViewModel.StopProcessingCommand}"
                        Content="停止处理"
                        Visibility="{x:Bind ViewModel.Inspector.StopProcessingVisibility, Mode=OneWay}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="InboxRetryProcessingButton"
                        Command="{x:Bind ViewModel.RetryProcessingCommand}"
                        Content="重新处理"
                        Visibility="{x:Bind ViewModel.Inspector.RetryProcessingVisibility, Mode=OneWay}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RecheckIngestRecoveryButton"
                        Command="{x:Bind ViewModel.RecheckRecoveryCommand}"
                        Content="重新检查"
                        Visibility="{x:Bind ViewModel.Inspector.RecheckRecoveryVisibility, Mode=OneWay}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RetryIngestCleanupButton"
                        Command="{x:Bind ViewModel.RetryCleanupCommand}"
                        Content="立即重试"
                        Visibility="{x:Bind ViewModel.Inspector.RetryCleanupVisibility, Mode=OneWay}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="OpenRecoveryLocationButton"
                        Command="{x:Bind ViewModel.OpenRecoveryLocationCommand}"
                        Content="打开文件位置"
                        Visibility="{x:Bind ViewModel.Inspector.OpenRecoveryLocationVisibility, Mode=OneWay}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="RetryInboxItemButton"
                            Command="{x:Bind ViewModel.RetryCommand}"
                            Content="重试" />
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="ClearMissingItemButton"
                            Command="{x:Bind ViewModel.ClearMissingCommand}"
                            Content="清除失效记录" />
                    </Grid>
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Spacing="14"
                    AutomationProperties.AutomationId="InboxBatchSummary"
                    AutomationProperties.Name="所选待入库文件的批量摘要"
                    Visibility="{x:Bind ViewModel.BatchSummaryVisibility, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="批量摘要" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Text="已选择" />
                        <TextBlock
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.BatchSummary.SelectedCount, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.BatchSummary.MediaCountText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.BatchSummary.StateCountText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Margin="0,18,0,0"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.BatchSummary.IngestProgressVisibility, Mode=OneWay}">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.BatchSummary.CurrentItemText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressBar
                        AutomationProperties.AutomationId="InboxBatchIngestProgress"
                        AutomationProperties.Name="批量入库总进度"
                        Maximum="100"
                        Value="{x:Bind ViewModel.BatchSummary.ProgressPercent, Mode=OneWay}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="InboxBatchStopAfterCurrentButton"
                        AutomationProperties.Name="当前项目安全完成后停止后续入库"
                        Command="{x:Bind ViewModel.StopBatchIngestCommand}"
                        Content="当前项完成后停止" />
                </StackPanel>
                <StackPanel
                    Grid.Row="3"
                    Margin="0,18,0,0"
                    Spacing="8"
                    AutomationProperties.AutomationId="InboxBatchIngestResult"
                    AutomationProperties.Name="批量入库结果"
                    Visibility="{x:Bind ViewModel.BatchSummary.FinalResultVisibility, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="批量入库结果" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="5">
                        <TextBlock Text="已完成" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BatchSummary.CompletedCount, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Text="存在冲突" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.BatchSummary.ConflictCount, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Text="需要前置处理" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.BatchSummary.RequiresProcessingCount, Mode=OneWay}" />
                        <TextBlock Grid.Row="3" Text="失败或已变化" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.BatchSummary.FailedOrChangedCount, Mode=OneWay}" />
                        <TextBlock Grid.Row="4" Text="未开始" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.BatchSummary.NotStartedCount, Mode=OneWay}" />
                    </Grid>
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="InboxBatchShowIncompleteButton"
                        AutomationProperties.Name="只显示本次批量入库中未完成的项目"
                        Command="{x:Bind ViewModel.ShowBatchIncompleteOnlyCommand}"
                        Content="只显示未完成项" />
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
        </controls:ResponsiveInspectorHost.InspectorContent>
    </controls:ResponsiveInspectorHost>
</Page>
