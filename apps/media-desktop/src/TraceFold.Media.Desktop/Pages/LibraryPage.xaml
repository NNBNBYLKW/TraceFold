<Page
    x:Class="TraceFold.Media.Desktop.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TraceFold.Media.Desktop.Controls"
    xmlns:pages="using:TraceFold.Media.Desktop.Pages">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" ColumnDefinitions="*,360">
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
            <StackPanel Margin="24,18,20,8">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="正式文件库" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="按显示名称管理资料，同时保留文件原始命名。" />
            </StackPanel>
            <AutoSuggestBox
                Grid.Row="1"
                Margin="24,8,20,14"
                AutomationProperties.AutomationId="LibrarySearchBox"
                PlaceholderText="搜索文件名或显示名称"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
            <GridView
                x:Name="LibraryGrid"
                Grid.Row="2"
                Margin="16,0,12,16"
                Padding="8"
                AutomationProperties.AutomationId="LibraryGrid"
                IsItemClickEnabled="True"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Single">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="pages:LibraryCardViewModel">
                        <Border
                            Width="190"
                            Margin="4"
                            Padding="10"
                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowDefinitions="120,Auto,Auto">
                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="5">
                                    <Grid>
                                        <Image
                                            Source="{x:Bind ThumbnailSource}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind ThumbnailVisibility}" />
                                        <FontIcon
                                            FontSize="30"
                                            Glyph="{x:Bind FallbackGlyph}"
                                            Visibility="{x:Bind FallbackVisibility}" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,9,0,0"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,3,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ActualFilename}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <Border
            Grid.Column="1"
            Padding="20"
            AutomationProperties.AutomationId="LibraryInspectorPane"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="资料" />
                    <controls:MediaPreviewControl
                        x:Name="PreviewControl"
                        Descriptor="{x:Bind ViewModel.Inspector.Preview, Mode=OneWay}" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Inspector.ActualFilename, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Inspector.TechnicalSummary, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBox
                        Header="显示名称"
                        PlaceholderText="不修改实际文件名"
                        Text="{x:Bind ViewModel.Inspector.Metadata.DisplayName, Mode=TwoWay}" />
                    <TextBlock FontWeight="SemiBold" Text="作者" />
                    <controls:TaxonomyPickerControl
                        x:Name="AuthorPicker"
                        SelectionChanged="OnAuthorSelectionChanged" />
                    <TextBlock FontWeight="SemiBold" Text="系列" />
                    <controls:TaxonomyPickerControl
                        x:Name="SeriesPicker"
                        SelectionChanged="OnSeriesSelectionChanged" />
                    <TextBlock FontWeight="SemiBold" Text="内容标签" />
                    <controls:TaxonomyPickerControl
                        x:Name="TagPicker"
                        SelectionChanged="OnTagSelectionChanged" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RevealAssetButton"
                        Command="{x:Bind ViewModel.RevealSelectedCommand}"
                        Content="打开所在目录" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
