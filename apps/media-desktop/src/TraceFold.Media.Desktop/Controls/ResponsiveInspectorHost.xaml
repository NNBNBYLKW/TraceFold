<UserControl
    x:Class="TraceFold.Media.Desktop.Controls.ResponsiveInspectorHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="HostRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <ContentPresenter
            x:Name="PrimaryPresenter"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalAlignment="Stretch"
            Content="{x:Bind PrimaryContent, Mode=OneWay}" />

        <Border
            x:Name="InspectorSurface"
            Grid.Column="1"
            VerticalAlignment="Stretch"
            Visibility="Collapsed">
            <ContentPresenter
                x:Name="InspectorPresenter"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Content="{x:Bind InspectorContent, Mode=OneWay}" />
        </Border>
    </Grid>
</UserControl>
