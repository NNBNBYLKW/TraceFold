<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <AssemblyName>TraceFold.Media</AssemblyName>
    <RootNamespace>TraceFold.Media.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TraceFold.Media.Application\TraceFold.Media.Application.csproj" />
    <ProjectReference Include="..\TraceFold.Media.Infrastructure\TraceFold.Media.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TraceFoldFfmpegSourceRoot)' != ''">
    <Content Include="$(TraceFoldFfmpegSourceRoot)\bin\ffmpeg.exe"
             Link="tools\ffmpeg\ffmpeg.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(TraceFoldFfmpegSourceRoot)\bin\ffprobe.exe"
             Link="tools\ffmpeg\ffprobe.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(TraceFoldFfmpegSourceRoot)\LICENSE"
             Link="tools\ffmpeg\LICENSE"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(TraceFoldFfmpegSourceRoot)\README.txt"
             Link="tools\ffmpeg\README.txt"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target
    Name="AddWinUiXamlToPublish"
    AfterTargets="ComputeResolvedFilesToPublishList"
    DependsOnTargets="AddProcessedXamlFilesToCopyLocal">
    <ItemGroup>
      <ResolvedFileToPublish
        Include="@(_ProcessedXamlFilesToCopyLocalWithTargetPath)"
        Condition="'%(Extension)' == '.xbf'">
        <RelativePath>%(_ProcessedXamlFilesToCopyLocalWithTargetPath.TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish
        Include="$(ProjectPriFullPath)"
        Condition="Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
