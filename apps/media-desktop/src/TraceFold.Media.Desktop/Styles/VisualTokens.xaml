<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Approved effective-pixel tokens (DIP). Later tasks must consume these keys
         instead of repeating literals. -->
    <x:Double x:Key="TraceFoldMinViewportWidth">1024</x:Double>
    <x:Double x:Key="TraceFoldMinViewportHeight">720</x:Double>
    <x:Double x:Key="TraceFoldWideBreakpoint">1280</x:Double>
    <x:Double x:Key="TraceFoldNavigationOpenPaneWidth">176</x:Double>
    <x:Double x:Key="TraceFoldNavigationCompactPaneWidth">48</x:Double>
    <x:Double x:Key="TraceFoldInspectorWidth">360</x:Double>
    <x:Double x:Key="TraceFoldFileRowHeight">38</x:Double>
    <x:Double x:Key="TraceFoldSectionSpacing">12</x:Double>
    <x:Double x:Key="TraceFoldControlSpacing">8</x:Double>

    <Thickness x:Key="TraceFoldPagePadding">20,18,20,16</Thickness>
    <Thickness x:Key="TraceFoldRowPadding">8,0,8,0</Thickness>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TraceFoldStatusHealthyBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="TraceFoldStatusAttentionBrush" Color="#8A4B00" />
            <SolidColorBrush x:Key="TraceFoldStatusCriticalBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="TraceFoldStatusQueuedBrush" Color="#5C2E91" />
            <SolidColorBrush x:Key="TraceFoldStatusRunningBrush" Color="#0067C0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TraceFoldStatusHealthyBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="TraceFoldStatusAttentionBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="TraceFoldStatusCriticalBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="TraceFoldStatusQueuedBrush" Color="#B146C2" />
            <SolidColorBrush x:Key="TraceFoldStatusRunningBrush" Color="#60CDFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
