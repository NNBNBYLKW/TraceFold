<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared presentation styles for the file workspaces. Every value references a
         semantic token so the migration tasks cannot reintroduce literals, and the media
         row keeps a fixed 38-DIP height with no card-width assumption. -->

    <Style x:Key="TraceFoldMediaListItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="{StaticResource TraceFoldFileRowHeight}" />
        <Setter Property="Height" Value="{StaticResource TraceFoldFileRowHeight}" />
        <Setter Property="Padding" Value="{StaticResource TraceFoldRowPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="TraceFoldMediaListStyle" TargetType="ListView">
        <Setter Property="Padding" Value="{StaticResource TraceFoldPagePadding}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource TraceFoldMediaListItemStyle}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="TraceFoldMediaRowHeaderStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource TraceFoldControlSpacing}" />
        <Setter Property="Padding" Value="{StaticResource TraceFoldRowPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="TraceFoldInspectorSurfaceStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource TraceFoldInspectorWidth}" />
        <Setter Property="Padding" Value="{StaticResource TraceFoldPagePadding}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="TraceFoldPageToolbarStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource TraceFoldSectionSpacing}" />
        <Setter Property="Padding" Value="{StaticResource TraceFoldRowPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
