<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>TraceFold.Media.UiAcceptance.Support</AssemblyName>
    <RootNamespace>TraceFold.Media.UiAcceptance.Support</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Read-only native UIA verification: the managed UIA client lives in the Windows Desktop
         framework, which is already present on every supported host. No package or network
         dependency is added. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
</Project>
